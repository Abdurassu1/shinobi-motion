{
  "name": "shinobi-motion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:vision": "node scripts/setup-vision.mjs",
    "postinstall": "npm run setup:vision"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
